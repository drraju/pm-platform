# PostgreSQL (backend started on the host)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pm_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-local-password

# Redis (backend started on the host)
REDIS_HOST=localhost
REDIS_PORT=6379

# Browser and API origins
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_ORIGIN=http://localhost:3000

# Authentication (use distinct, randomly generated values)
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
